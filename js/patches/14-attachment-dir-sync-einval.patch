--- a/@deepseek-ai/dsh-attachment-local/lib/index.js
+++ b/@deepseek-ai/dsh-attachment-local/lib/index.js
@@ -401,5 +401,12 @@
 	try {
-		await handle.sync();
+		try {
+			await handle.sync();
+		} catch (error) {
+			// DSH-Android: some Android filesystems return EINVAL/ENOTSUP for a directory fsync;
